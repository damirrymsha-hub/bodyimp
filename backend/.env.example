# Скопируй в .env (локально) или задай как переменные окружения на Railway.
OPENROUTER_API_KEY=your_openrouter_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# На Railway укажи путь внутри подключённого volume (см. инструкцию):
DATABASE_URL=sqlite:////data/bodyimp.db

# URL фронтенда на Vercel (для CORS в проде):
FRONTEND_URL=https://your-app.vercel.app

APP_NAME=BodyImp
# В проде обязательно production — тогда CORS ограничивается FRONTEND_URL:
ENV=production
