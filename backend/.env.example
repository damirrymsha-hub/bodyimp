# Скопируй в .env (локально) или задай как переменные окружения на хостинге (Render).
OPENROUTER_API_KEY=your_openrouter_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Локально — SQLite; на Render — строка подключения Neon Postgres
# (postgresql://user:pass@host/db?sslmode=require):
DATABASE_URL=sqlite:///./bodyimp.db

# URL фронтенда на Vercel (для CORS в проде):
FRONTEND_URL=https://your-app.vercel.app

APP_NAME=BodyImp
# В проде обязательно production — тогда CORS ограничивается FRONTEND_URL:
ENV=production

# --- Webhook-режим бота (нужен на Render free: сервис засыпает, polling не работает) ---
# На Render НЕ задавать: RENDER_EXTERNAL_URL подставляется автоматически.
# Вне Render можно задать вручную публичный URL бэкенда:
# WEBHOOK_BASE_URL=https://your-backend.onrender.com
# Любая случайная строка — защита webhook от посторонних запросов:
TELEGRAM_WEBHOOK_SECRET=change_me_random_string

# --- Модели ИИ-анализа еды ---
# Не задано — бесплатные модели (лимит ~50 зап/день, с депозитом $10 — 1000/день).
# Платная конфигурация (рекомендуется, ~$0.3/мес при 5-7 фото/день):
# AI_MODELS=google/gemini-3.1-flash-lite,google/gemma-4-31b-it:free
# AI_ENSEMBLE=0  # одна сильная модель вместо ансамбля из двух (быстрее и дешевле)
# deploy-test: 1784273132
